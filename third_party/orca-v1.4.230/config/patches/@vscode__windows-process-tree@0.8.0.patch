diff --git a/src/process_worker.cc b/src/process_worker.cc
--- a/src/process_worker.cc
+++ b/src/process_worker.cc
@@ -43,8 +43,29 @@
           Napi::String::New(env, pinfo.commandLine));
     }
 
+    if ((CREATIONTIME & process_data_flags_) && pinfo.creationTimeMs != 0) {
+      object.Set("creationTimeMs",
+                 Napi::Number::New(env, static_cast<double>(pinfo.creationTimeMs)));
+    }
+
+    if (process_data_flags_ == CREATIONTIME) {
+      object.Set("name", Napi::String::New(env, pinfo.snapshotName));
+      object.Set("creationTimeDiagnosticVersion", Napi::Number::New(env, 2));
+      object.Set("creationTimeProvider", Napi::String::New(env, "NtQuerySystemInformation"));
+      object.Set("creationTimeNtStatus", Napi::Number::New(env, pinfo.creationTimeNtStatus));
+      object.Set("creationTimeSnapshotComplete", Napi::Boolean::New(env, true));
+    }
     result.Set(i, object);
   }
 
   Callback().Call({result});
 }
+
+void GetProcessesWorker::OnError(const Napi::Error& error) {
+  if (process_data_flags_ != CREATIONTIME) {
+    Napi::AsyncWorker::OnError(error);
+    return;
+  }
+  Napi::HandleScope scope(Env());
+  Callback().Call({Env().Undefined()});
+}
