+        GROUP_RELATIONSHIP Group;
+    } DUMMYUNIONNAME;
+} SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX, \
+    *PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX;
