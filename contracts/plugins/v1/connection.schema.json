{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swa.local/contracts/plugins/v1/connection.schema.json",
  "title": "Project-bound plugin connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "plugin_id", "transport", "configuration_ref", "contract_version", "scopes", "version"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "plugin_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "transport": {"enum": ["stdio", "streamable-http"]},
    "configuration_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "contract_version": {"const": "1"},
    "scopes": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["references.read", "events.record"]}},
    "version": {"type": "integer", "minimum": 1}
  }
}
